# ── Supabase (accounts, database, sync) ────────────────────────────────
# Leave these empty to run STAMP in local-only mode: "Continue without an
# account" works, and email sign-in runs in a clearly labelled demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Anthropic (the Archivist and the Diplomat) ─────────────────────────
# Server-only. Never prefix with NEXT_PUBLIC_. Without a key, both tools
# fall back to keyword matching against the catalog.
ANTHROPIC_API_KEY=
# Optional override; defaults to a current Claude model.
ANTHROPIC_MODEL=

# Optional: public site URL used for magic-link and OAuth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── World archives (Discover search beyond the catalog) ────────────────
# Books (Open Library), manga/anime (AniList) and albums (MusicBrainz) need no key.
# Films & series: free key from themoviedb.org → Settings → API (v3 key or v4 token).
TMDB_API_KEY=
# Games: free key from rawg.io/apidocs
RAWG_API_KEY=
